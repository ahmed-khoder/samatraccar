# Your Traccar server (no trailing slash). Required.
TRACCAR_URL=https://your-traccar-server.example.com

# Session cookie "secure" flag. Default: on in production (needs HTTPS — e.g. behind Nginx Proxy Manager with SSL).
# Set to false only if you open the app over plain http (http://server-ip:3000) while testing.
# COOKIE_SECURE=false

# Where the analytics/address caches are stored (Docker sets /data). Default: ./.cache
# CACHE_DIR=./.cache
