# Your Traccar server (no trailing slash). Required.
TRACCAR_URL=https://your-traccar-server.example.com

# Session cookie "secure" flag. Auto-detected: HTTPS (also behind Nginx Proxy Manager, via X-Forwarded-Proto) => secure,
# plain http://ip:3000 => not secure. Set true/false only to force it.
# COOKIE_SECURE=

# Where the analytics/address caches are stored (Docker sets /data). Default: ./.cache
# CACHE_DIR=./.cache

# Host port that Docker publishes (default 3000). Change it if 3000 is already taken.
# APP_PORT=3000
